{
	"name": "PL_RDrive_to_Land_Media",
	"properties": {
		"activities": [
			{
				"name": "Copy AV to Land",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Clean up landing zone",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@pipeline().globalParameters.gpm_cision_media_av_path",
								"type": "Expression"
							},
							"wildcardFileName": {
								"value": "@variables('var_file_name')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_av_binary_folder",
						"type": "DatasetReference",
						"parameters": {
							"pm_host": {
								"value": "@pipeline().globalParameters.gpm_av_host",
								"type": "Expression"
							},
							"pm_user": {
								"value": "@pipeline().globalParameters.gpm_av_user",
								"type": "Expression"
							},
							"pm_key": {
								"value": "@pipeline().globalParameters.gpm_av_pass_key",
								"type": "Expression"
							},
							"pm_folder": {
								"value": "@pipeline().globalParameters.gpm_cision_media_av_path",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_land_binary_folder",
						"type": "DatasetReference",
						"parameters": {
							"pm_container": {
								"value": "@pipeline().globalParameters.gpm_land_container",
								"type": "Expression"
							},
							"pm_folder": {
								"value": "@pipeline().globalParameters.gpm_cision_media_land_path",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy File from R Drive to AV",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Clean up AV files",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": false,
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "FileServerWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_FS_rdrive_binary_file",
						"type": "DatasetReference",
						"parameters": {
							"host_name": "svm1",
							"file_path": {
								"value": "@pipeline().globalParameters.gpm_cision_media_rdrive_path",
								"type": "Expression"
							},
							"ad_user_name": {
								"value": "@pipeline().globalParameters.gpm_cision_rdrive_user_name",
								"type": "Expression"
							},
							"kv_pass_key": {
								"value": "@pipeline().globalParameters.gpm_cision_rdrive_user_secret",
								"type": "Expression"
							},
							"filename": {
								"value": "@variables('var_file_name')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_av_binary",
						"type": "DatasetReference",
						"parameters": {
							"pm_host": {
								"value": "@pipeline().globalParameters.gpm_av_host",
								"type": "Expression"
							},
							"pm_user": {
								"value": "@pipeline().globalParameters.gpm_av_user",
								"type": "Expression"
							},
							"pm_key": {
								"value": "@pipeline().globalParameters.gpm_av_pass_key",
								"type": "Expression"
							},
							"pm_folder": {
								"value": "@pipeline().globalParameters.gpm_cision_media_av_path",
								"type": "Expression"
							},
							"pm_filename": {
								"value": "@variables('var_file_name')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Clean up AV files",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "Set file name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_av_binary_folder",
						"type": "DatasetReference",
						"parameters": {
							"pm_host": "@pipeline().globalParameters.gpm_av_host",
							"pm_user": "@pipeline().globalParameters.gpm_av_user",
							"pm_key": "@pipeline().globalParameters.gpm_av_pass_key",
							"pm_folder": {
								"value": "@pipeline().globalParameters.gpm_cision_media_av_path",
								"type": "Expression"
							}
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "FileServerReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "Clean up landing zone",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "Copy File from R Drive to AV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_land_binary_folder",
						"type": "DatasetReference",
						"parameters": {
							"pm_container": "@pipeline().globalParameters.gpm_land_container",
							"pm_folder": "@pipeline().globalParameters.gpm_cision_media_land_path"
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "Set file name",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_file_name",
					"value": {
						"value": "@replace(pipeline().globalParameters.gpm_cision_media_file, '{date}', pipeline().parameters.date)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"date": {
				"type": "string",
				"defaultValue": "2025-10-20"
			}
		},
		"variables": {
			"var_file_name": {
				"type": "String"
			}
		},
		"folder": {
			"name": "cision/Sub Control"
		},
		"annotations": []
	}
}