				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.skip_Sftp_to_Av,1)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "PL_SFTP_to_AV_ISA",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SFTP_to_AV_ISA",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"file": {
										"value": "@pipeline().parameters.file",
										"type": "Expression"
									},
									"date": {
										"value": "@subtractFromTime(utcnow('yyyy-MM-dd'), pipeline().parameters.delta, 'Day','yyyy-MM-dd')",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
