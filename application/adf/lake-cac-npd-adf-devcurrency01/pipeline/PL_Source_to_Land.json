{
	"name": "PL_Source_to_Land",
	"properties": {
		"activities": [
			{
				"name": "Set return values",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "ForEach - filenames",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "dates",
							"value": {
								"type": "Expression",
								"content": "@union(variables('var_dates'), json('[]'))"
							}
						}
					],
					"setSystemVariable": true
				}
			},
			{
				"name": "ForEach - filenames",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Find new files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('var_filenames')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Set date",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "extract_date",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "var_date",
								"value": {
									"value": "@activity('extract_date').output.pipelineReturnValue.value",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append dates",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "PL_Copy_Source_Files",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "var_dates",
								"value": {
									"value": "@variables('var_date')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "extract_date",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Call_AZF_Func",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"function": "extractDate",
									"parameters": {
										"value": "@json(\n    concat(\n    '{',\n    '\"str\":\"', item(), '\",',\n    '\"regex\":\"', replace(pipeline().parameters.param_date_regex,'\\','\\\\'), '\",',\n    '\"iformat\":\"',pipeline().parameters.param_date_iformat, '\",',\n    '\"oformat\":\"', pipeline().parameters.param_date_oformat, '\"',\n    '}'\n))",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "PL_Copy_Source_Files",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Set date",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Copy_Source_Files",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"param_src_connection": {
										"value": "@pipeline().parameters.param_src_connection",
										"type": "Expression"
									},
									"param_file_name": {
										"value": "@item()",
										"type": "Expression"
									},
									"param_land_container": {
										"value": "@pipeline().parameters.param_land_container",
										"type": "Expression"
									},
									"param_land_path": {
										"value": "@concat(pipeline().parameters.param_land_path,'/',variables('var_date'))",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Next",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Append dates",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "extract_date",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			},
			{
				"name": "Filter files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "PL_Find_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('PL_Find_Files').output.pipelineReturnValue.files",
						"type": "Expression"
					},
					"condition": {
						"value": "@if(empty(pipeline().parameters.param_file_pattern), \n        true,\n        contains(item(), pipeline().parameters.param_file_pattern))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Find new files",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filter files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@empty(pipeline().parameters.param_file_date)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Filter by file_date",
							"type": "Filter",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('Filter files').output.value",
									"type": "Expression"
								},
								"condition": {
									"value": "@contains(item(), pipeline().parameters.param_file_date)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set filenames - match file_date",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Filter by file_date",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "var_filenames",
								"value": {
									"value": "@activity('Filter by file_date').output.value",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "get_new_files",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Call_DBK_Func",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"param_name": "find_new_files",
									"param_args": {
										"value": "@json(\n    concat(\n    '{',\n    '\"files\":\"', join(activity('Filter files').output.value,'|'), '\",',\n    '\"raw_container\":\"', pipeline().parameters.param_raw_container, '\",',\n    '\"raw_path\":\"',pipeline().parameters.param_raw_path, '\",',\n    '}'\n))",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Set filenames - new files",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "get_new_files",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "var_filenames",
								"value": {
									"value": "@union(activity('get_new_files').output.pipelineReturnValue.value,activity('get_new_files').output.pipelineReturnValue.value)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "PL_Find_Files",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Find_Source_Files",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"param_src_connection": {
							"value": "@pipeline().parameters.param_src_connection",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Set return values - No date",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "PL_Find_Files",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "dates",
							"value": {
								"type": "Array",
								"content": [
									{
										"type": "String",
										"content": "[]"
									}
								]
							}
						}
					],
					"setSystemVariable": true
				}
			}
		],
		"parameters": {
			"param_src_connection": {
				"type": "object",
				"defaultValue": {
					"type": "SPO",
					"drive_id": "b!B0POKey_t0KIrs6pdmcVtEunRbzOyRdAvuXVDC1n8iYXpVN3QykORbdvLSZmE9c8",
					"path": "Reports-Ottawa/Datalake_Files"
				}
			},
			"param_file_date": {
				"type": "string"
			},
			"param_file_pattern": {
				"type": "string"
			},
			"param_raw_container": {
				"type": "string",
				"defaultValue": "restricted"
			},
			"param_raw_path": {
				"type": "string",
				"defaultValue": "raw/internal/qm/lab"
			},
			"param_land_container": {
				"type": "string",
				"defaultValue": "land-currency"
			},
			"param_land_path": {
				"type": "string",
				"defaultValue": "qm/lab"
			},
			"param_date_regex": {
				"type": "string",
				"defaultValue": "^(.{10})"
			},
			"param_date_iformat": {
				"type": "string",
				"defaultValue": "yyyy-MM-dd"
			},
			"param_date_oformat": {
				"type": "string",
				"defaultValue": "yyyy-MM-dd"
			}
		},
		"variables": {
			"var_filenames": {
				"type": "Array"
			},
			"var_date": {
				"type": "String"
			},
			"var_dates": {
				"type": "Array",
				"defaultValue": []
			}
		},
		"folder": {
			"name": "Common/Framework/Common"
		},
		"annotations": []
	}
}