{
	"name": "PL_Run_Multiple_Dates",
	"properties": {
		"activities": [
			{
				"name": "lkp_Dates_File",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_file_type_dates",
						"type": "DatasetReference",
						"parameters": {
							"pm_container": "config-currency",
							"pm_folder": "common",
							"pm_filename": "curr_file_type_load_dates.json"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "ForEach",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lkp_Dates_File",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lkp_Dates_File').output.firstRow.dates",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(pipeline().parameters.p_input_stream,'isa')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "PL_Multiple_Sources_M7",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_Multiple_Sources_M7",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"file": {
													"value": "@pipeline().parameters.p_input_file_type",
													"type": "Expression"
												},
												"delta": {
													"value": "@int(div(sub(ticks(utcnow('yyyy-MM-dd')),ticks(item().date)),864000000000))",
													"type": "Expression"
												},
												"skip_Sftp_to_Av": {
													"value": "@pipeline().parameters.skip_Sftp_to_Av",
													"type": "Expression"
												},
												"skip_Av_to_Land": {
													"value": "@pipeline().parameters.skip_Av_to_Land",
													"type": "Expression"
												},
												"skip_Land_to_Raw": {
													"value": "@pipeline().parameters.skip_Land_to_Raw",
													"type": "Expression"
												},
												"skip_Raw_to_Standard": {
													"value": "@pipeline().parameters.skip_Raw_to_Standard",
													"type": "Expression"
												},
												"skip_Archive_Files": {
													"value": "@pipeline().parameters.skip_Archive_Files",
													"type": "Expression"
												},
												"mode": {
													"value": "@pipeline().parameters.mode",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "PL_Control_Main_ISA",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_Control_Main_ISA",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"file": {
													"value": "@pipeline().parameters.p_input_file_type",
													"type": "Expression"
												},
												"delta": {
													"value": "@int(div(sub(ticks(utcnow('yyyy-MM-dd')),ticks(item().date)),864000000000))\n",
													"type": "Expression"
												},
												"skip_Sftp_to_Av": {
													"value": "@pipeline().parameters.skip_Sftp_to_Av",
													"type": "Expression"
												},
												"skip_Av_to_Land": {
													"value": "@pipeline().parameters.skip_Av_to_Land",
													"type": "Expression"
												},
												"skip_Land_to_Raw": {
													"value": "@pipeline().parameters.skip_Land_to_Raw",
													"type": "Expression"
												},
												"skip_Raw_to_Standard": {
													"value": "@pipeline().parameters.skip_Raw_to_Standard",
													"type": "Expression"
												},
												"skip_Archive_Files": {
													"value": "@pipeline().parameters.skip_Archive_Files",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_input_stream": {
				"type": "string",
				"defaultValue": "isa"
			},
			"p_input_file_type": {
				"type": "string",
				"defaultValue": "ExtractHstbTransfer"
			},
			"skip_Sftp_to_Av": {
				"type": "int",
				"defaultValue": 0
			},
			"skip_Av_to_Land": {
				"type": "int",
				"defaultValue": 0
			},
			"skip_Land_to_Raw": {
				"type": "int",
				"defaultValue": 0
			},
			"skip_Raw_to_Standard": {
				"type": "int",
				"defaultValue": 0
			},
			"skip_Archive_Files": {
				"type": "int",
				"defaultValue": 1
			},
			"mode": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Common"
		},
		"annotations": []
	}
}