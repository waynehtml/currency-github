					{
						"activity": "Set Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.skip_Sftp_to_Av,1)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Execute SFTP to AV",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SFTP_to_AV_M7",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"date": {
										"value": "@variables('date')",
										"type": "Expression"
									},
									"file": {
										"value": "@pipeline().parameters.file",
										"type": "Expression"
									},
									"hostname": {
										"value": "@pipeline().parameters.p_src_hostname",
										"type": "Expression"
									},
									"username": {
										"value": "@pipeline().parameters.p_src_username",
										"type": "Expression"
									},
									"key": {
										"value": "@pipeline().parameters.p_src_key",
										"type": "Expression"
									},
									"folder": {
										"value": "@pipeline().parameters.p_src_folder",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
