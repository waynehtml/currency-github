					},
					"ifFalseActivities": [
						{
							"name": "Execute Binary_Converter",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Binary_Converter2",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
