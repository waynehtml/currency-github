{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "List_all_the_blobs_based_on_a_URI": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "blobUri": "config-currency/m7/bn"
          },
          "serviceProviderConfiguration": {
            "connectionName": "AzureBlob-land01",
            "operationId": "listBlobsFromUri",
            "serviceProviderId": "/serviceProviders/AzureBlob"
          }
        },
        "runAfter": {}
      },
      "Run_query_and_list_results": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "azuremonitorlogs"
            }
          },
          "method": "post",
          "body": "ADFPipelineRun",
          "path": "/queryData",
          "queries": {
            "subscriptions": "1de5fd2d-2313-461a-acc4-07cdc509cdf4",
            "resourcegroups": "lake-cac-npd-rg-devplatform",
            "resourcetype": "Log Analytics Workspace",
            "resourcename": "lake-cac-npd-log-dev01",
            "timerange": "Last hour"
          }
        },
        "runAfter": {
          "List_all_the_blobs_based_on_a_URI": [
            "SUCCEEDED"
          ]
        }
      },
      "Get_emails_(V3)": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "office365"
            }
          },
          "method": "get",
          "path": "/v3/Mail",
          "queries": {
            "importance": "Any",
            "fetchOnlyWithAttachment": false,
            "folderPath": "Inbox",
            "fetchOnlyUnread": true,
            "fetchOnlyFlagged": false,
            "includeAttachments": false,
            "top": 10
          }
        },
        "runAfter": {
          "Run_query_and_list_results": [
            "SUCCEEDED"
          ]
        }
      },
      "Create_a_pipeline_run": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "azuredatafactory"
            }
          },
          "method": "post",
          "path": "/subscriptions/@{encodeURIComponent('1de5fd2d-2313-461a-acc4-07cdc509cdf4')}/resourcegroups/@{encodeURIComponent('lake-cac-npd-rg-devcurrency')}/providers/Microsoft.DataFactory/factories/@{encodeURIComponent('lake-cac-npd-adf-devcurrency01')}/pipelines/@{encodeURIComponent('PL_Run_Notebook_UC')}/CreateRun",
          "queries": {
            "x-ms-api-version": "2017-09-01-preview"
          }
        },
        "runAfter": {
          "Get_emails_(V3)": [
            "SUCCEEDED"
          ]
        }
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {},
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "GET"
        }
      }
    }
  },
  "kind": "Stateful"
}