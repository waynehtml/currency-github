				"dependsOn": [
					{
						"activity": "If Skip Sftp to AV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.skip_Av_to_Land,1)",
