{
	"name": "PL_Raw_to_Standardized_M7_Load",
	"properties": {
		"activities": [
			{
				"name": "Raw to Standardized",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat('/currency/m7/',pipeline().parameters.file,'/20_standardized/raw_to_standardized')",
						"type": "Expression"
					},
					"baseParameters": {
						"container": {
							"value": "@pipeline().parameters.container",
							"type": "Expression"
						},
						"storage": {
							"value": "@pipeline().globalParameters.gpm_storage",
							"type": "Expression"
						},
						"land_storage": {
							"value": "@pipeline().globalParameters.gpm_land_storage",
							"type": "Expression"
						},
						"kv_scope": {
							"value": "@pipeline().parameters.kv_scope",
							"type": "Expression"
						},
						"spn_id_secret": {
							"value": "@pipeline().parameters.spn_id_secret",
							"type": "Expression"
						},
						"spn_key_secret": {
							"value": "@pipeline().parameters.spn_key_secret",
							"type": "Expression"
						},
						"tenant_id_secret": {
							"value": "@pipeline().parameters.tenant_id_secret",
							"type": "Expression"
						},
						"land_container": {
							"value": "@pipeline().parameters.land_container",
							"type": "Expression"
						},
						"date": {
							"value": "@pipeline().parameters.date",
							"type": "Expression"
						},
						"file": {
							"value": "@pipeline().parameters.file",
							"type": "Expression"
						},
						"site": {
							"value": "@pipeline().parameters.site",
							"type": "Expression"
						},
						"mode": {
							"value": "@pipeline().parameters.mode",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_databricks_UC",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"date": {
				"type": "string"
			},
			"file": {
				"type": "string"
			},
			"container": {
				"type": "string",
				"defaultValue": "restricted"
			},
			"land_container": {
				"type": "string",
				"defaultValue": "land-currency"
			},
			"tenant_id_secret": {
				"type": "string",
				"defaultValue": "lake-tenant-id"
			},
			"spn_key_secret": {
				"type": "string",
				"defaultValue": "spn-currencyservices-key"
			},
			"spn_id_secret": {
				"type": "string",
				"defaultValue": "spn-currencyservices-id"
			},
			"kv_scope": {
				"type": "string",
				"defaultValue": "lake-kv-currency-scope"
			},
			"site": {
				"type": "string",
				"defaultValue": "maoc"
			},
			"mode": {
				"type": "string",
				"defaultValue": "overwrite"
			}
		},
		"variables": {
			"v_file_type": {
				"type": "String"
			}
		},
		"folder": {
			"name": "M7/Dynamic"
		},
		"annotations": []
	}
}