						},
						"spn_id_secret": {
							"value": "@pipeline().globalParameters.spn_id_secret",
							"type": "Expression"
						},
						"spn_key_secret": {
							"value": "@pipeline().globalParameters.spn_key_secret",
							"type": "Expression"
						},
						"tenant_id_secret": {
							"value": "@pipeline().globalParameters.tenant_id_secret",
